 "conversions": {
  "horizontal": "EPSG:2263 numbers read as EPSG:6539 (NAD83(2011) / NY Long Island, US ft, the LAS header's CRS) -> EPSG:9057 WGS 84 (G2139) with pyproj (about 0.9 m north, 0.1 m west of the NAD83 position) -> local metres: x = (lon - lon0)\u00b7111320\u00b7cos(lat0), y = (lat - lat0)\u00b7111320; LiDAR tiles use a quadratic fit to pyproj per tile (checked to 1 cm)",
  "vertical": "NAVD88 US ft \u00d7 1200/3937 = NAVD88 m (GEOID18 per the vendor report); same datum as 3DEP",
  "usSurveyFootM": 0.3048006096012192,
  "lidarScale": "LAS scale \u00d7 X/Y/Z + offset, in US ft"
 },
 "notes": [
  "DTM = class-2 mean per 0.5 m cell, class-9 water mean where no ground, gaps filled from the nearest measured cell then smoothed",
  "CHM = class-5 max - DTM where 3x3 class-5 count >= 3, not on roofs",
  "crowns: Gaussian sigma 1 cell, local maxima within a Popescu-Wynne window (min 3 m), watershed over CHM > 2 m, radius = sqrt(area/pi) >= 1 m and >= height/12",
  "canopy masked by NYC footprints and LOD2 footprints widened 1 m"
 ]
